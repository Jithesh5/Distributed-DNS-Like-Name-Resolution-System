from mininet.topo import Topo

class DistributedDNSTopo(Topo):
    def build(self):
        client = self.addHost("client", ip="10.0.0.2/24", mac="00:00:00:00:00:01")
        dns1 = self.addHost("dns1", ip="10.0.0.3/24", mac="00:00:00:00:00:02")
        dns2 = self.addHost("dns2", ip="10.0.0.4/24", mac="00:00:00:00:00:03")
        s1 = self.addSwitch("s1", protocols="OpenFlow13")
        self.addLink(client, s1)
        self.addLink(dns1, s1)
        self.addLink(dns2, s1)

topos = {"dns": lambda: DistributedDNSTopo()}
